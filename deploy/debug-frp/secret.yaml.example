apiVersion: v1
kind: Secret
metadata:
  name: ai-agent-debug-frp
  namespace: vanke
type: Opaque
stringData:
  authorized_keys: |
    ssh-ed25519 REPLACE_WITH_YOUR_TEMP_DEBUG_PUBLIC_KEY ai-agent-debug-frp
  frpc.ini: |
    [common]
    server_addr = 110.40.237.78
    server_port = 443
    token = REPLACE_WITH_FRP_TOKEN_FROM_110

    [ai-agent-debug-ssh-30088]
    type = tcp
    local_ip = 127.0.0.1
    local_port = 22
    remote_port = 30088
