{
  "name": "artifact-generator",
  "display_name": "Artifact Generator",
  "description": "Generate files through structured specs, skill execution, preview, verification, and one repair retry.",
  "model": {
    "provider": "openai_compatible",
    "model": "Qwen3.6-35B-A3B",
    "base_url": "http://124.132.152.75:62091/v1",
    "model_env": "LLM_MODEL",
    "default_model": "Qwen3.6-35B-A3B",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.25,
    "max_tokens": 4096
  },
  "runtime": {
    "stateless": true,
    "max_tool_rounds": 8,
    "max_retries": 1,
    "workspace_mode": "ephemeral_thread",
    "require_verification": true
  },
  "tools": ["present_files", "artifact_workflow", "ask_clarification"],
  "skills": [
    "drawio-generation",
    "pptx-generation",
    "excel-generation",
    "xmind-generation",
    "markdown-rendering",
    "deliverables-export"
  ],
  "workflows": {
    "default": "agent_loop",
    "generation": "artifact_workflow"
  },
  "routing": {
    "llm_workflow_router": true,
    "llm_workflow_router_env": "LLM_WORKFLOW_ROUTER"
  },
  "quality": {
    "auto_repair": true,
    "verify_outputs": true,
    "fail_on_missing_artifact": true
  },
  "prompts": {
    "system": "You are a stateless artifact-generation agent. Always build a structured spec before executing generation skills. Verify generated outputs before final reply. If verification fails, repair the spec and retry once.",
    "response_language": "zh-CN"
  }
}
