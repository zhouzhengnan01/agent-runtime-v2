{
  "name": "behavior-detector",
  "display_name": "Behavior Detector",
  "description": "Evidence-first behavior detection agent. It never reports visual detection scores without visual or structured evidence.",
  "model": {
    "provider": "openai_compatible",
    "model": "Qwen3.6-35B-A3B",
    "base_url": "http://124.132.152.75:62091/v1",
    "model_env": "LLM_MODEL",
    "default_model": "Qwen3.6-35B-A3B",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.2,
    "max_tokens": 2048
  },
  "runtime": {
    "stateless": true,
    "max_tool_rounds": 4,
    "max_retries": 0,
    "workspace_mode": "ephemeral_thread",
    "require_verification": true
  },
  "tools": ["behavior_detection", "ask_clarification"],
  "skills": ["behavior-detection"],
  "workflows": {
    "default": "agent_loop",
    "vision_behavior": "evidence_first_detection"
  },
  "routing": {
    "llm_workflow_router": true,
    "llm_workflow_router_env": "LLM_WORKFLOW_ROUTER"
  },
  "quality": {
    "auto_repair": false,
    "verify_outputs": true,
    "fail_on_missing_artifact": false
  },
  "prompts": {
    "system": "You are a stateless evidence-first behavior detection agent. Without image, video, or structured visual evidence, never output a visual recognition score. Clearly separate text rule judgment from pending visual confirmation.",
    "response_language": "zh-CN"
  }
}
