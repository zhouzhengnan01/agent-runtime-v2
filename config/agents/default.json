{
  "name": "default",
  "display_name": "JetLinks 智能体",
  "description": "General JetLinks assistant with chat, artifact generation, and evidence-first behavior detection.",
  "model": {
    "provider": "openai_compatible",
    "model": "Qwen3.6-35B-A3B",
    "base_url": "http://124.132.152.75:62091/v1",
    "model_env": "LLM_MODEL",
    "default_model": "Qwen3.6-35B-A3B",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY",
    "tool_choice": "none",
    "temperature": 0.4,
    "max_tokens": 2048
  },
  "runtime": {
    "stateless": true,
    "max_tool_rounds": 6,
    "max_retries": 0,
    "workspace_mode": "ephemeral_thread",
    "require_verification": false
  },
  "tools": [
    "present_files",
    "behavior-detection",
    "local_read_file",
    "local_write_file",
    "local_search_text",
    "local_todo",
    "local_shell_command",
    "memory_remember",
    "memory_search",
    "memory_forget",
    "memory_md_list",
    "memory_md_read",
    "memory_md_append",
    "memory_md_search",
    "memory_md_compress"
  ],
  "skills": [
    "drawio-generation",
    "pptx-generation",
    "excel-generation",
    "xmind-generation",
    "markdown-rendering",
    "deliverables-export",
    "behavior-detection"
  ],
  "workflows": {
    "default": "agent_loop",
    "generation": "artifact_workflow",
    "vision_behavior": "evidence_first_detection"
  },
  "routing": {
    "llm_workflow_router": true,
    "llm_workflow_router_env": "LLM_WORKFLOW_ROUTER"
  },
  "memory": {
    "enabled": true,
    "scope": "agent",
    "max_items": 20,
    "inject_context": true,
    "markdown_enabled": true,
    "markdown_writable_scopes": [
      "session"
    ],
    "markdown_max_chars": 12000
  },
  "quality": {
    "auto_repair": false,
    "verify_outputs": false,
    "fail_on_missing_artifact": false
  },
  "prompts": {
    "system": "You are a JetLinks agent. Use only the provided messages, attachments, tools, and explicitly injected memories. Do not assume memories that were not provided.",
    "response_language": "zh-CN"
  }
}
