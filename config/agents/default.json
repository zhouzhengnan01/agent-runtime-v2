{
  "name": "default",
  "display_name": "JetLinks 智能体",
  "description": "General JetLinks assistant. Workflow plugins are selected explicitly through runtime_options.workflow.",
  "model": {
    "provider": "openai_compatible",
    "model": "qwen3.6-27b",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model_env": "LLM_MODEL",
    "default_model": "qwen3.6-27b",
    "base_url_env": "LLM_BASE_URL",
    "api_key_env": "LLM_API_KEY",
    "tool_choice": "auto",
    "temperature": 0.4,
    "max_tokens": 2048
  },
  "runtime": {
    "stateless": true,
    "max_tool_rounds": 6,
    "context_compression_enabled": true,
    "context_max_chars": 120000,
    "context_keep_first_messages": 2,
    "context_keep_last_messages": 8,
    "max_retries": 0,
    "workspace_mode": "ephemeral_thread",
    "require_verification": false
  },
  "tools": [
    "present_files",
    "artifact_manifest_read",
    "artifact_manifest_update",
    "artifact_list",
    "artifact_read",
    "artifact_write",
    "artifact_patch",
    "behavior-detection",
    "local_read_file",
    "local_write_file",
    "local_search_text",
    "local_todo",
    "local_shell_command",
    "delegate_task",
    "memory_remember",
    "memory_search",
    "memory_forget",
    "memory_md_list",
    "memory_md_read",
    "memory_md_append",
    "memory_md_search",
    "memory_md_compress"
  ],
  "skills": [
    "drawio-generation",
    "pptx-generation",
    "excel-generation",
    "xmind-generation",
    "markdown-rendering",
    "deliverables-export",
    "behavior-detection"
  ],
  "routing": {
    "llm_workflow_router": false,
    "llm_workflow_router_env": "LLM_WORKFLOW_ROUTER"
  },
  "memory": {
    "enabled": true,
    "scope": "agent",
    "max_items": 20,
    "inject_context": true,
    "markdown_enabled": true,
    "markdown_writable_scopes": [
      "session"
    ],
    "markdown_max_chars": 12000
  },
  "quality": {
    "auto_repair": false,
    "verify_outputs": false,
    "fail_on_missing_artifact": false
  },
  "prompts": {
    "system": "You are a JetLinks agent. Use only the provided messages, attachments, tools, and explicitly injected memories. Do not assume memories that were not provided. When the user asks to create, modify, preview, export, or continue work on deliverables, use artifact workspace tools to store durable results under the current thread outputs instead of returning large file contents in chat. Read the artifact manifest before modifying existing deliverables, patch or rewrite the target file, and keep the final reply short with the relevant artifact path or preview information.",
    "response_language": "zh-CN"
  }
}
