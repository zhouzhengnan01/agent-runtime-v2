{
  "name": "markdown-rendering",
  "description": "Generate rich Markdown artifacts.",
  "output_kind": "markdown",
  "generation": true,
  "routing": {
    "summary": "Use for Markdown documents, architecture notes, reports, tables, Mermaid diagrams, ECharts blocks, and rich text artifacts.",
    "keywords": [
      "markdown",
      "md",
      "文档",
      "报告",
      "说明",
      "mermaid",
      "表格"
    ],
    "examples": [
      "生成一份 markdown 架构说明",
      "输出一份技术报告",
      "生成带 Mermaid 的文档"
    ]
  },
  "quality_template": [
    "mermaid",
    "tables",
    "echarts_block",
    "attachment_block"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "skill_name",
      "title"
    ],
    "properties": {
      "skill_name": {
        "const": "markdown-rendering"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "title",
            "content"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "required": [
      "artifacts"
    ],
    "properties": {
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "mime_type",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mime_type": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "markdown"
              ]
            }
          }
        }
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "profile": null,
    "request_schema_version": "skill-run.v1",
    "fallback_to_local": true
  },
  "model_tags": [
    "chat"
  ]
}
