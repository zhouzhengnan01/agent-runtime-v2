{
  "name": "image-dataset-produce",
  "description": "Generate synthetic training images from image1 reference images and prompt plans through the local flux2 image generation HTTP API.",
  "output_kind": "image",
  "generation": true,
  "workflow_capabilities": [
    "image_generation"
  ],
  "routing": {
    "summary": "Use as the flux2 fallback when composite image generation is unavailable, out of quota, or when a prompt should expand image1 reference images into synthetic training images.",
    "keywords": [
      "生成图片",
      "数据增强",
      "扩充数据集",
      "训练数据生成",
      "参考图生成",
      "image generation",
      "synthetic dataset",
      "augmentation",
      "flux",
      "flux2"
    ],
    "examples": [
      "基于 image1 文件夹里的每张图片生成训练增强图",
      "当合成图像额度不足时使用 flux2 生成替代训练图片"
    ]
  },
  "quality_template": [
    "input_image",
    "prompt",
    "output_dir",
    "result_image_path",
    "generation_summary"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "skill_name",
      "input_image",
      "prompt"
    ],
    "properties": {
      "skill_name": {
        "const": "image-dataset-produce"
      },
      "input_image": {
        "type": "string",
        "description": "Absolute local path to one reference image from image1."
      },
      "prompt": {
        "type": "string",
        "description": "Image generation prompt."
      },
      "output_dir": {
        "type": "string",
        "description": "Absolute output directory. Defaults to the current thread outputs directory."
      },
      "api_url": {
        "type": "string",
        "default": "http://218.67.242.10:58801/v1/flux2/generate"
      },
      "token": {
        "type": "string",
        "default": "abc@123"
      },
      "model": {
        "type": "string",
        "default": "flux2"
      },
      "width": {
        "type": "integer",
        "default": 640
      },
      "height": {
        "type": "integer",
        "default": 640
      },
      "steps": {
        "type": "integer",
        "default": 8
      },
      "timeout": {
        "type": "integer",
        "default": 120
      }
    },
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "required": [
      "artifacts"
    ],
    "properties": {
      "artifacts": {
        "type": "array"
      },
      "result_image_path": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    },
    "additionalProperties": true
  },
  "execution": {
    "type": "python_script",
    "runtime": "local_subprocess",
    "script": "scripts/run_generation.py",
    "input_mode": "json_file",
    "args": [
      "--input",
      "{workspace}/image-dataset-produce-input.json"
    ],
    "timeout_seconds": 180,
    "collect_outputs": true,
    "stderr_filename": "image-dataset-produce-stderr.txt"
  },
  "sandbox": {
    "enabled": true,
    "profile": "python-skill",
    "request_schema_version": "skill-run.v1",
    "adapter_command": "python {package_dir}/scripts/run_generation.py --input {request_path}",
    "fallback_to_local": true
  },
  "model_tags": [
    "image_generation",
    "vision_segmentation"
  ]
}
