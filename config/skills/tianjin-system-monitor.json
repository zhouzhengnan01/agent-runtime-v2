{
  "name": "tianjin-system-monitor",
  "description": "使用大模型和当前会话文件实现天津园区系统运行概览，读取健康检查、系统信息、统计、概览和日志。",
  "output_kind": "markdown",
  "generation": true,
  "routing": {
    "summary": "使用大模型和当前会话文件实现天津园区系统运行概览，读取健康检查、系统信息、统计、概览和日志。",
    "keywords": [
      "系统监控",
      "健康检查",
      "日志",
      "审计",
      "overview",
      "stats"
    ],
    "examples": [
      "查看系统健康状态",
      "拉取最近系统日志",
      "分析访问日志"
    ]
  },
  "quality_template": [
    "local_model_generation",
    "artifact_report"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "skill_name"
    ],
    "properties": {
      "skill_name": {
        "const": "tianjin-system-monitor"
      },
      "action": {
        "type": "string",
        "enum": [
          "health",
          "info",
          "stats",
          "overview",
          "system_logs",
          "access_logs"
        ],
        "description": "要执行的能力动作。"
      },
      "api_base_url": {
        "type": "string",
        "description": "可选。仅 mode=backend 时用于覆盖天津后端 API base URL。"
      },
      "timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      },
      "time_range": {
        "type": "string",
        "enum": [
          "1h",
          "6h",
          "24h",
          "7d"
        ],
        "default": "24h"
      },
      "level": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "service_name": {
        "type": "string"
      },
      "ip": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "method": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "mode": {
        "type": "string",
        "enum": [
          "local",
          "backend"
        ],
        "default": "local",
        "description": "执行模式。默认 local：使用当前 Runtime 大模型和会话文件生成成果；backend：显式调用天津后端 HTTP API。"
      }
    },
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "required": [
      "artifacts"
    ],
    "properties": {
      "artifacts": {
        "type": "array"
      },
      "data": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "sandbox": {
    "enabled": false,
    "profile": null,
    "request_schema_version": "skill-run.v1",
    "fallback_to_local": true
  },
  "model_tags": [
    "chat",
    "tool_call"
  ]
}
