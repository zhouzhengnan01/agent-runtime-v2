    "validationRules": {
        "componentTemplate": {
            "mustCloneFromRegistryTemplate": true,
            "mustKeepUnknownFields": true,
            "mustNotGenerateUnregisteredComponent": true
        },
        "position": {
            "stylePath": "componentProps.style",
            "mustStayInsideRegionContentBox": true,
            "mustStayInsideSlotWhenSlotIsUsed": true
        },
        "background": {
            "mustUploadBackgroundSvgCommand": true,
            "uploadBackgroundSvgCommand": "fileService / UploadFile",
            "backgroundUploadParameterShape": "{\"fileName\":\"background.svg\",\"contentType\":\"image/svg+xml;charset=UTF-8\",\"content\":\"base64-utf8-svg\"}",
            "backgroundFileIdPath": "pageJson.canvas.backgroundImage.fileId"
        },
        "customChart": {
            "mustGenerateResourceEntity": true,
            "mustUseRandomResourceIdBeforeSave": true,
            "resourceIdPrefix": "component_",
            "resourceEntityIdPath": "resourceId",
            "resourceScriptPath": "configuration.javaScript",
            "componentResourceIdPath": "componentProps.resource.id",
            "componentResourceVersionPath": "componentProps.resource.version",
            "mustUseSameResourceIdInResourceAndComponent": true,
            "mustUseVersionZero": true,
            "mustNotWriteScriptIntoPageComponent": true,
            "mustUseDefaultFuncSignature": true,
            "mustCallCreateVisualizationResourceCommand": true,
            "createVisualizationResourceCommand": "visualizationService:resource / Add",
            "resourceCommandParameterShape": "{\"data\":[resourceEntityJson]}",
            "mustReturnGeneratedPageJson": false,
            "mustReturnRegionComponentResponse": true,
            "mustNotCallCreateVisualizationProjectCommand": true,
            "pageJsonReturnShape": "progressiveRegionResponse",
            "mustNotUseCommandResultAsResourceId": true
        }
    }
