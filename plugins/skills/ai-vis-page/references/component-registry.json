{
    "registryVersion": "1.0.0",
    "name": "bigscreen-platform-component-registry",
    "description": "Real platform component registry for AI-generated visualization big screens.",
    "componentFilesBasePath": "references/components",
    "resourceFilesBasePath": "references/resources",
    "output": {
        "backgroundSvgRequiredFile": false,
        "backgroundSvgUpload": "fileService / UploadFile",
        "backgroundImageFileIdPath": "pageJson.canvas.backgroundImage.fileId",
        "pageJson": "progressive initialization response pageJson",
        "generatedResourcesDir": "generated-bigscreen/resources",
        "initializationResponse": {
            "pageJson": {
                "canvas": {},
                "components": []
            },
            "blueprint": {}
        },
        "regionComponentResponse": {
            "regionId": "__REGION_ID__",
            "components": []
        }
    },
    "pageJsonRules": {
        "rootStructure": "platform-canvas-json",
        "mustUseCanvasRoot": true,
        "mustUseComponentsRoot": true,
        "mustNotWrapWithPageObject": true,
        "canvasPath": "canvas",
        "componentArrayPath": "components",
        "progressiveMode": true,
        "initializationResponseRoot": "pageJson",
        "regionResponseRoot": "components"
    },
    "commandIntegration": {
        "enabled": true,
        "commands": {
            "uploadBackgroundSvg": {
                "serviceId": "fileService",
                "commandId": "UploadFile",
                "usedBy": [
                    "pageJson.canvas.backgroundImage.fileId"
                ],
                "parameters": {
                    "fileName": "background.svg",
                    "contentType": "image/svg+xml;charset=UTF-8",
                    "content": "base64-utf8-svg"
                },
                "contentEncoding": "base64",
                "resultFileIdPath": "id",
                "writeResultTo": "pageJson.canvas.backgroundImage.fileId"
            },
            "createVisualizationResource": {
                "serviceId": "visualizationService:resource",
                "commandId": "Add",
                "usedBy": [
                    "custom-chart"
                ],
                "parameters": {
                    "data": [
                        "resource-entity-json"
                    ]
                },
                "bodySource": "generated-bigscreen/resources/{resourceId}.resource.json",
                "resourceIdSource": "generated-before-save",
                "doNotUseResultAsResourceId": true
            }
        }
    },
    "allowedComponentKeys": [
        "text",
        "table",
        "dateTime",
        "video",
        "pseudo",
        "custom-chart",
        "custom-component"
    ],
    "currentWorkflowOverride": {
        "tabsForbidden": true,
        "mapIntentComponentKey": "pseudo",
        "mapIntentStrategy": "deep-clone components/pseudo.json and patch allowed paths only",
        "mapTemplate": "components/pseudo.json",
        "mapMustNotUse": [
            "custom-chart",
            "resourceComponentEcharts",
            "echarts",
            "series",
            "geo",
            "option",
            "echartsOption",
            "markers",
            "points"
        ],
        "pseudoPointSchema": [
            "name",
            "longitude",
            "dimension",
            "value"
        ],
        "pseudoLatitudeField": "dimension",
        "pseudoAllowedPatchPaths": [
            "id",
            "name",
            "componentProps.style.x",
            "componentProps.style.y",
            "componentProps.style.width",
            "componentProps.style.height",
            "componentProps.style.rotate.angle",
            "dataSourceProps.defaultValue",
            "componentProps.basicMap.bgColor",
            "componentProps.basicMap.boundaryLinColor",
            "componentProps.basicMap.interactionEffect",
            "componentProps.basicMap.mouseHover",
            "componentProps.basicMap.mouseClick",
            "componentProps.basicMap.coordinateColor",
            "componentProps.basicMap.coordinateSize",
            "componentProps.basicMap.NfontSize",
            "componentProps.basicMap.NfontColor",
            "componentProps.basicMap.Nblod",
            "componentProps.basicMap.Nitalic",
            "componentProps.basicMap.seat",
            "componentProps.basicMap.FfontSize",
            "componentProps.basicMap.FfontColor",
            "componentProps.basicMap.Fblod",
            "componentProps.basicMap.Fitalic",
            "componentProps.basicMap.suspendedBabel",
            "componentProps.basicMap.flash",
            "componentProps.basicMap.flashTime"
        ]
    },
    "globalPatchRules": {
        "componentId": {
            "mode": "replace",
            "path": "id",
            "pattern": "{platformType}_{role}_{random}"
        },
        "componentName": {
            "mode": "replace",
            "path": "name"
        },
        "positionAndSize": {
            "mode": "replace",
            "paths": {
                "x": "componentProps.style.x",
                "y": "componentProps.style.y",
                "width": "componentProps.style.width",
                "height": "componentProps.style.height"
            }
        },
        "rotate": {
            "mode": "keep",
            "path": "componentProps.style.rotate"
        },
        "unknownFields": {
            "mode": "keep"
        }
    },
    "resourceRules": {
        "enabled": true,
        "resourceIdGeneration": {
            "mode": "random-before-save",
            "description": "Generate resourceId before calling the save command. The same resourceId must be written into both the resource entity JSON and the page component JSON.",
            "prefix": "component_",
            "pattern": "component_{timestamp}_{random4}",
            "example": "component_1779881457212_4829",
            "doNotWaitForSaveResult": true
        },
        "resourceVersion": {
            "mode": "fixed",
            "value": 0
        },
        "customChartResourceBinding": {
            "componentKey": "custom-chart",
            "resourceEntityIdPath": "resourceId",
            "resourceEntityVersionPath": "version",
            "resourceScriptPath": "configuration.javaScript",
            "componentResourceIdPath": "componentProps.resource.id",
            "componentResourceVersionPath": "componentProps.resource.version",
            "mustUseSameResourceId": true,
            "mustUseVersionZero": true,
            "doNotWaitForSaveResult": true,
            "mustCallSaveCommand": true,
            "saveCommandName": "createVisualizationResource"
        }
    },
    "businessMapping": {
        "title": "text",
        "subtitle": "text",
        "label": "text",
        "metric-text": "text",
        "kpi": "text",
        "description": "text",
        "panel-title": "text",
        "current-time": "dateTime",
        "date-time": "dateTime",
        "system-time": "dateTime",
        "ranking": "table",
        "alarm-list": "table",
        "event-list": "table",
        "device-list": "table",
        "status-table": "table",
        "top-list": "table",
        "bar-chart": "custom-chart",
        "line-chart": "custom-chart",
        "area-chart": "custom-chart",
        "pie-chart": "custom-chart",
        "gauge": "custom-chart",
        "map-visual": "pseudo",
        "main-visual": "pseudo",
        "geo-map": "pseudo",
        "spatial-distribution": "pseudo",
        "point-map": "pseudo",
        "city-map": "pseudo",
        "park-map": "pseudo",
        "province-map": "pseudo",
        "china-map": "pseudo",
        "trend": "custom-chart",
        "distribution": "custom-chart",
        "comparison": "custom-chart",
        "video": "video",
        "camera": "video",
        "monitoring": "video",
        "category-switch": "custom-component",
        "panel-switch": "custom-component",
        "chart-switch": "custom-component",
        "data-view-switch": "custom-component"
    },
    "chartGroupMapping": {
        "line": "line-chart",
        "bar": "bar-chart",
        "area": "line-chart",
        "pie": "pie-chart",
        "gauge": "gauge"
    },
    "components": [
        {
            "key": "text",
            "name": "文本框",
            "platformType": "text",
            "file": "components/text.json",
            "requiresResourceEntity": false,
            "usage": [
                "title",
                "subtitle",
                "label",
                "metric-text",
                "kpi",
                "description",
                "panel-title"
            ],
            "preferredRegions": [
                "header",
                "global_metrics"
            ],
            "preferredSlots": [
                "header_left",
                "header_title",
                "metric_1",
                "metric_2",
                "metric_3",
                "metric_4",
                "metric_5"
            ],
            "cloneStrategy": {
                "mode": "deep-clone-template",
                "keepUnknownFields": true,
                "doNotSimplifyTemplate": true
            },
            "patchRules": {
                "id": "replace",
                "name": "replace",
                "type": "keep",
                "visible": "keep",
                "isLocked": "keep",
                "componentProps.style.x": "replace",
                "componentProps.style.y": "replace",
                "componentProps.style.width": "replace",
                "componentProps.style.height": "replace",
                "componentProps.style.rotate": "keep",
                "dataSourceProps.mode": "keep",
                "dataSourceProps.type": "keep",
                "dataSourceProps.defaultValue[0].text": "replace",
                "dataSourceProps.sourceId": "keep",
                "dataSourceProps.mapping": "keep",
                "componentProps.font.fontSize": "replace-if-needed",
                "componentProps.font.fontWeight": "replace-if-needed",
                "componentProps.font.color": "replace-if-needed",
                "componentProps.font.horizontalAlign": "replace-if-needed",
                "componentProps.font.verticalAlign": "replace-if-needed",
                "componentProps.font.isTextShadow": "replace-if-needed",
                "componentProps.font.textShadow": "replace-if-needed",
                "componentProps.text.sweepLight": "replace-if-needed"
            },
            "contentRules": {
                "textPath": "dataSourceProps.defaultValue[0].text",
                "titleText": {
                    "recommendedFontSize": 34,
                    "recommendedFontWeight": "bold",
                    "recommendedHorizontalAlign": "center",
                    "recommendedVerticalAlign": "center"
                },
                "metricText": {
                    "recommendedFontSize": 18,
                    "recommendedFontWeight": "bold",
                    "recommendedHorizontalAlign": "center",
                    "recommendedVerticalAlign": "center"
                },
                "labelText": {
                    "recommendedFontSize": 14,
                    "recommendedFontWeight": "normal",
                    "recommendedHorizontalAlign": "center",
                    "recommendedVerticalAlign": "center"
                }
            }
        },
