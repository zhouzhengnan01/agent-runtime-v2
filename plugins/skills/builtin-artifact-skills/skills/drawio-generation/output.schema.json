{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "diagram_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "web_url": {
          "type": "string"
        }
      }
    }
  },
  "required": ["success", "message", "outputs", "result"]
}
