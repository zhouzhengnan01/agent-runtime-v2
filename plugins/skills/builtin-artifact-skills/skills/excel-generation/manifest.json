{
  "name": "excel-generation",
  "description": "Generate Excel workbooks.",
  "output_kind": "spreadsheet",
  "generation": true,
  "routing": {
    "summary": "Use for Excel workbooks, spreadsheets, templates, data tables, validations, and formula-based summaries.",
    "keywords": [
      "excel",
      "xlsx",
      "表格",
      "模板",
      "工作簿",
      "数据表",
      "公式"
    ],
    "examples": [
      "生成一份 excel 设备模板",
      "做一个状态汇总表",
      "输出带校验的 XLSX 模板"
    ]
  },
  "quality_template": [
    "field_types",
    "formulas",
    "styles",
    "freeze_panes",
    "summary_sheet",
    "validation"
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "sheets": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "message": {
        "type": "string"
      },
      "output_path": {
        "type": "string"
      },
      "outputPath": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "result": {
        "type": "object"
      }
    },
    "required": [
      "success",
      "message",
      "outputs",
      "result"
    ]
  },
  "sandbox": {
    "enabled": true,
    "profile": "office",
    "request_schema_version": "skill-run.v1",
    "adapter_command": "python /opt/jetlinks/skills/run_skill.py --request {request_path} --outputs {outputs_dir}",
    "fallback_to_local": true
  }
}
