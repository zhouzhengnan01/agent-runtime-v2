{
  "name": "data-auto-annotation",
  "description": "Use SAM3 to auto-annotate uploaded images, or prepare YOLO training datasets through inspection, optional synthetic image composition, COCO merge, split verification, and dataset.yaml export.",
  "output_kind": "json",
  "generation": true,
  "workflow_capabilities": [
    "auto_annotation",
    "data_preparation"
  ],
  "quality_template": [
    "coco_schema",
    "image_dimensions",
    "bbox_xywh",
    "category_mapping",
    "dataset_yaml",
    "split_verification"
  ],
  "routing": {
    "summary": "Use for automatic image annotation, object detection pre-labeling, COCO JSON export, and YOLO training dataset preparation.",
    "keywords": [
      "自动标注",
      "数据标注",
      "COCO",
      "YOLO",
      "dataset.yaml",
      "数据集准备",
      "训练数据准备",
      "合成数据",
      "目标检测",
      "sam3",
      "annotation",
      "labeling",
      "dataset",
      "data preparation"
    ],
    "examples": [
      "把这张图片自动标注成 COCO",
      "用 person car 标注图片并导出 coco.json",
      "生成目标检测预标注数据",
      "把这个 YOLO 数据集准备成可训练的 dataset.yaml 并按 7:2:1 切分"
    ]
  },
  "execution": {
    "type": "python_script",
    "runtime": "local_subprocess",
    "script": "scripts/sam3-predict.py",
    "input_mode": "none",
    "args": [
      "--url",
      "$SAM3_PREDICT_URL",
      "--input-json",
      "$spec_json",
      "--connect-timeout",
      "5",
      "--timeout",
      "12",
      "--output",
      "{outputs}/annotations.coco.json"
    ],
    "timeout_seconds": 25,
    "collect_outputs": true,
    "outputs": [
      {
        "path": "annotations.coco.json"
      }
    ],
    "stderr_filename": "data-auto-annotation-stderr.txt"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "skill_name"
    ],
    "properties": {
      "skill_name": {
        "const": "data-auto-annotation"
      },
      "image_path": {
        "type": "string",
        "description": "Local image file path or directory path containing images. Prefer the real uploaded attachment path."
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Class labels to detect, e.g. person, car, helmet."
      },
      "dataset_root": {
        "type": "string",
        "description": "Optional dataset root for full YOLO data preparation. When provided, the runner uses the dataset preparation pipeline instead of single SAM3 annotation."
      },
      "work_dir": {
        "type": "string",
        "description": "Optional pipeline working directory."
      },
      "output_dir": {
        "type": "string",
        "description": "Optional prepared dataset output directory."
      },
      "image1": {
        "type": "string",
        "description": "Optional first image source or background folder for synthetic image composition."
      },
      "image2": {
        "type": "string",
        "description": "Optional second image source or foreground/object folder for synthetic image composition."
      },
      "generation_prompt": {
        "type": "string",
        "description": "Optional prompt used to generate synthetic/composite training images."
      },
      "split_requested": {
        "type": "boolean",
        "default": true
      },
      "skip_generation": {
        "type": "boolean",
        "default": false
      },
      "format": {
        "type": "string",
        "const": "coco",
        "default": "coco"
      }
    },
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "required": [
      "artifacts"
    ],
    "properties": {
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "mime_type",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mime_type": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "json",
                "text"
              ]
            }
          }
        }
      }
    },
    "additionalProperties": true
  },
  "sandbox": {
    "enabled": true,
    "profile": "python-skill",
    "request_schema_version": "skill-run.v1",
    "adapter_command": "python {package_dir}/scripts/sam3-predict.py --input-json {request_path} --output {outputs_dir}/annotations.coco.json",
    "fallback_to_local": true
  },
  "model_tags": [
    "vision_segmentation"
  ]
}
